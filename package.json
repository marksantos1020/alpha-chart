{
  "name": "alpha-chart",
  "version": "0.1.0",
  "description": "TradingView-style trading chart for React on lightweight-charts: drawing tools, indicator panes, legend, layouts. Data, storage and indicator engine are pluggable.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "files": ["src", "LICENSE", "README.md"],
  "sideEffects": ["*.css"],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/geometry.test.ts --bundle --platform=node --format=cjs --outfile=test-results/geometry.cjs --log-level=warning && node test-results/geometry.cjs"
  },
  "peerDependencies": {
    "lightweight-charts": "^5.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.5",
    "lightweight-charts": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
